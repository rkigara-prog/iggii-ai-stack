# ------------------------------------------------------------------
# Reference only. DO NOT put real values in this file, and never
# commit a filled-in copy of it.
#
# Real values go in a file that lives OUTSIDE this git checkout on
# the Unraid box, e.g.:
#   /mnt/user/appdata/iggii-ai-stack/secrets.env
# docker-compose.yml points at that absolute path via env_file:, so
# it survives every `git pull` / runner checkout untouched.
# ------------------------------------------------------------------

# LiteLLM proxy admin key (clients call the proxy with this, not with
# the underlying provider keys). Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-changeme

# Provider keys — separate from your ChatGPT Pro / Claude Pro subscriptions.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama endpoint (workstation, NOT reachable from outside your LAN)
OLLAMA_BASE_URL=http://192.168.113.32:11434
