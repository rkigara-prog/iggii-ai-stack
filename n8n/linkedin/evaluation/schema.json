{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen local content evaluation packet",
  "type": "object",
  "required": ["id", "as_of", "topic", "claims", "sources"],
  "properties": {
    "id": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "topic": {"type": "string"},
    "private_context": {"type": "string"},
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "text"],
        "properties": {"id": {"type": "string"}, "text": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "publisher", "published_at", "retrieved_at", "title", "search_description", "page_passages", "evidence_origin", "synthetic"],
        "properties": {
          "id": {"type": "string"}, "url": {"type": "string", "format": "uri"},
          "publisher": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string"}, "title": {"type": "string"},
          "search_description": {"type": "string"}, "page_passages": {"type": "string"},
          "evidence_origin": {"type": "string"}, "synthetic": {"type": "boolean"},
          "retrieval_status": {"type": ["integer", "null"]},
          "sourceTier": {"type": ["string", "null"]},
          "full_text_sha256": {"type": ["string", "null"]},
          "derived_from": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
